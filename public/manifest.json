{
  "manifest_version": 3,
  "name": "Huruv",
  "short_name": "Huruv",
  "version": "0.1.2",
  "description": "Type Arabic with a French or English keyboard. Local, configurable transliteration in any text field.",
  "author": "Huruv",
  "homepage_url": "https://github.com/Hexendi/Huruv",
  "minimum_chrome_version": "109",
  "browser_specific_settings": {
    "gecko": {
      "id": "arabictype@huruv.app",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": ["storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_title": "Huruv",
    "default_popup": "popup.html",
    "default_area": "navbar",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_end",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["fonts/*.woff2"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
